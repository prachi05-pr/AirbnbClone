<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FORM WANDERLUST</title>
</head>
<body>
    <h2>CREATE A NEW LISTING</h2>
    <BR><BR><BR>
 <form method="POST" action="/listings">
<p>Enter Title     <input name="title" placeholder="Enter title" type="text"> </p>
<br/>
<textarea name="description" placeholder="Enter description" type="text"></textarea>
<br/><br>
<input name="image" placeholder="Enter image url/link"  type="text">
<br/><br>
<input name="price" placeholder="Enter price" type="number">
<br/><br>
<input name="location" placeholder="Enter location" type="number">
<br/><br>
<input name="country" placeholder="Enter country"  type="text">
<br/><br>
<button>Add</button>
 </form>   
</body>
</html>



