<%- layout("/layouts/boilerplate.ejs") %>

<div class="row mt-3">
<div class="col-8 offset-2">
    <h3>Listing Details :</h3>
</div>
    <div class="card col-md-6 row-2 offset-2">
      <img 
      src="<%= listing.image.url %>"
      class="card-img-top show-img"
      alt="listing-image"
      />
        <div class="card-body">
            <h5 class="card-text">
              <b><%= listing.title %></h5> </b> <br> 
              <%= listing.description %> <br>
   &#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %> 
              <b>Location:</b> <%= listing.location %> <br>
               <b>Country:</b><%= listing.country %>
           
            </div>
          </div>
   
    <br>
    <div class="mt-3 btns">
    <a  href="/listings/<%= listing._id %>/edit" class="btn add-btn">Edit </a>
    </div>
<br>
    <div class="mt-3">
  <form method="POST" action="/listings/<%= listing._id%>?_method=DELETE">
  <button type="submit" class="btn btn-dark ">Delete</button>
</form>
</div>

</div>
</div>

