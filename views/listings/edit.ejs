<!-- <%- layout("/layouts/boilerplate")%> -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Create New Listing | WanderLust</title>
</head>
<body>

  <h2>Edit Your Listing</h2>

  <form method="POST" action="/listings/<%=listing._id %>?_method=PUT">
    <label for="title">Title</label>
    <input name="listing[title]" id="title" type="text" value="<%= listing.title %>" required>
    <br><br>

    <label for="description">Description</label>
    <textarea name="listing[description]" id="description" type="text"  required row="5" col="10"><%=listing.description%></textarea>
    <br><br>

    <label for="image">Image URL</label>
    <input name="listing[image]" id="image" type="text" value="<%=listing.image.url %>" required>
    <br><br>

    <label for="price">Price</label>
    <input name="listing[price]" id="price" type="number" value="<%= listing.price %>" required>
    <br><br>

    <label for="location">Location</label>
    <input name="listing[location]" id="location" type="text" value="<%=listing.location %>" required>
    <br><br>
    <label for="country">Country</label>
    <input name="listing[country]" id="country" type="text" value="<%=listing.country%>" required>


    <button type="submit" method="POST" action="/listings">Update</button>
  </form>

</body>
</html>
